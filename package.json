{
  "name": "spotifood",
  "version": "1.0.0",
  "repository": "git@github.com:emunhoz/spotifood.git",
  "author": "emunhoz",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "license": "MIT",
  "scripts": {
    "commit": "git-cz",
    "watch:tokens": "bun --filter @monorepo/design-tokens start",
    "watch:components": "bun --filter @monorepo/ui-components start",
    "test:components": "bun --filter @monorepo/ui-components test",
    "test:update": "bun --filter @monorepo/ui-components test:update && bun --filter @monorepo/spotifood test:update",
    "test:app": "bun --filter @monorepo/spotifood test",
    "postinstall": "bun --filter @monorepo/design-tokens libbuild && bun --filter @monorepo/ui-components libbuild",
    "start": "cd apps/web && bun run start",
    "build-app": "bun --filter @monorepo/spotifood build",
    "storybook": "cd packages/ui && bun run storybook",
    "build-storybook": "bun --filter @monorepo/ui-components build-storybook",
    "lint": "bun --filter @monorepo/ui-components lint && bun --filter @monorepo/spotifood lint",
    "lint:css": "bun --filter @monorepo/ui-components lint:css && bun --filter @monorepo/spotifood lint:css",
    "test:ci": "bun --filter @monorepo/ui-components test:coverage && bun --filter @monorepo/spotifood test:coverage"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^12.1.4",
    "@commons/eslint-config": "*",
    "@commons/stylelint-config": "*",
    "commitizen": "^4.2.2",
    "cz-conventional-changelog": "^3.3.0",
    "git-commit-msg": "^0.3.0",
    "husky": "^6.0.0",
    "typescript": "^5.6.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
