{
  "name": "@monorepo/ui-components",
  "version": "0.10.4",
  "description": "Monorepo ui components",
  "author": "emunhoz",
  "license": "ISC",
  "main": "dist/src/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p ./src",
    "start": "tsc -p . --watch",
    "test": "jest --config=./jest.config.js --colors",
    "test:update": "jest --config=./jest.config.js --u --colors",
    "test:watch": "jest --config=./jest.config.js --watch --colors",
    "test:coverage": "jest --config=./jest.config.js --coverage --colors",
    "lint": "eslint 'src/**/*.{js,ts,tsx}'",
    "lint:css": "stylelint 'src/**/*.tsx' -f verbose --color",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -c .storybook -o public",
    "generate:component": "plop",
    "libbuild": "tsc -p . && bun run add-assets",
    "add-assets": "copyfiles -u 1 'src/**/!(*.js|*.mdx|*.jsx|*.map|*.ts|*.tsx)' dist/src/",
    "watch": "tsc && bun run add-assets"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "8.6.14",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-links": "8.6.14",
    "@storybook/blocks": "8.6.14",
    "@storybook/react": "8.6.14",
    "@storybook/react-vite": "8.6.14",
    "@testing-library/jest-dom": "^5.10.1",
    "@testing-library/react": "^11.2.2",
    "@types/jest": "^26.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-router-dom": "^5.1.7",
    "@types/styled-components": "^5.1.5",
    "@vitejs/plugin-react": "^4.3.0",
    "copyfiles": "^2.4.1",
    "jest": "^26.0.1",
    "plop": "^2.7.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^5.2.0",
    "storybook": "8.6.14",
    "styled-components": "^5.2.1",
    "ts-jest": "^26.1.0",
    "vite": "^5.4.0"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17",
    "styled-components": "^5.2.1"
  }
}
