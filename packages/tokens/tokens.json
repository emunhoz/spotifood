{
  "color": {
    "$type": "color",
    "$description": "Dark values live in $extensions.mode.dark. They are a placeholder: the monochrome scale is mirrored and primaries are kept. To be redesigned in Figma.",
    "primary": { "$value": "#EA1D2C", "$extensions": { "mode": { "dark": "#EA1D2C" } } },
    "primaryLight": { "$value": "#FF7B85", "$extensions": { "mode": { "dark": "#FF7B85" } } },
    "primaryDark": { "$value": "#AA000C", "$extensions": { "mode": { "dark": "#AA000C" } } },
    "lightest": { "$value": "#FCFCFC", "$extensions": { "mode": { "dark": "#3E3E3E" } } },
    "lighter": { "$value": "#F7F7FC", "$extensions": { "mode": { "dark": "#717171" } } },
    "light": { "$value": "#EFF0F6", "$extensions": { "mode": { "dark": "#A6A6A6" } } },
    "mediumlight": { "$value": "#D9DBE9", "$extensions": { "mode": { "dark": "#D9DBE9" } } },
    "dark": { "$value": "#A6A6A6", "$extensions": { "mode": { "dark": "#EFF0F6" } } },
    "darker": { "$value": "#717171", "$extensions": { "mode": { "dark": "#F7F7FC" } } },
    "darkest": { "$value": "#3E3E3E", "$extensions": { "mode": { "dark": "#FCFCFC" } } }
  },
  "typography": {
    "type": {
      "$type": "fontFamily",
      "primary": { "$value": "\"Poppins\", \"Helvetica Neue\", Helvetica, Arial, sans-serif" },
      "code": { "$value": "\"SFMono-Regular\", Consolas, \"Liberation Mono\", Menlo, Courier, monospace" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": "400" },
      "medium": { "$value": "500" },
      "bold": { "$value": "700" },
      "extrabold": { "$value": "900" }
    },
    "size": {
      "$type": "dimension",
      "s1": { "$value": "12px" },
      "s2": { "$value": "14px" },
      "s3": { "$value": "16px" },
      "s4": { "$value": "18px" },
      "m1": { "$value": "20px" },
      "m2": { "$value": "24px" },
      "m3": { "$value": "28px" },
      "l1": { "$value": "32px" },
      "l2": { "$value": "40px" },
      "l3": { "$value": "48px" },
      "code": { "$value": "90px" }
    }
  },
  "attributes": {
    "borderRadius": {
      "$type": "dimension",
      "small": { "$value": "5px" },
      "default": { "$value": "10px" },
      "big": { "$value": "20px" },
      "xbig": { "$value": "40px" }
    },
    "boxShadow": {
      "$type": "shadow",
      "small": { "$value": "0 0 46px 0 rgba(0, 0, 0, 0.13)" },
      "hover": { "$value": "0 0 15px 0 rgba(0, 0, 0, 0.13)" }
    }
  },
  "breakpoints": {
    "$type": "dimension",
    "sm": { "$value": "576px" },
    "md": { "$value": "768px" },
    "lg": { "$value": "992px" },
    "xl": { "$value": "1200px" }
  }
}
