{
  "typography": {
    "type": {
      "$type": "fontFamily",
      "primary": {
        "$value": "\"Poppins\", \"Helvetica Neue\", Helvetica, Arial, sans-serif"
      },
      "code": {
        "$value": "\"SFMono-Regular\", Consolas, \"Liberation Mono\", Menlo, Courier, monospace"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": "400"
      },
      "medium": {
        "$value": "500"
      },
      "bold": {
        "$value": "700"
      },
      "extrabold": {
        "$value": "900"
      }
    },
    "size": {
      "$type": "dimension",
      "s1": {
        "$value": "12px"
      },
      "s2": {
        "$value": "14px"
      },
      "s3": {
        "$value": "16px"
      },
      "s4": {
        "$value": "18px"
      },
      "m1": {
        "$value": "20px"
      },
      "m2": {
        "$value": "24px"
      },
      "m3": {
        "$value": "28px"
      },
      "l1": {
        "$value": "32px"
      },
      "l2": {
        "$value": "40px"
      },
      "l3": {
        "$value": "48px"
      },
      "code": {
        "$value": "90px"
      }
    }
  },
  "attributes": {
    "borderRadius": {
      "$type": "dimension",
      "small": {
        "$value": "5px"
      },
      "default": {
        "$value": "10px"
      },
      "big": {
        "$value": "20px"
      },
      "xbig": {
        "$value": "40px"
      }
    },
    "boxShadow": {
      "$type": "shadow",
      "small": {
        "$value": "0 0 46px 0 rgba(0, 0, 0, 0.13)"
      },
      "hover": {
        "$value": "0 0 15px 0 rgba(0, 0, 0, 0.13)"
      }
    }
  },
  "breakpoints": {
    "$type": "dimension",
    "sm": {
      "$value": "576px"
    },
    "md": {
      "$value": "768px"
    },
    "lg": {
      "$value": "992px"
    },
    "xl": {
      "$value": "1200px"
    }
  }
}
